# Base PostgreSQL (Neon ou Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/borneflix?sslmode=require"

# Session admin (32 caractères minimum)
SESSION_SECRET="remplacer-par-une-chaine-aleatoire-longue"

# Compte administrateur créé au premier démarrage s'il n'existe pas
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="remplacer-par-un-mot-de-passe"

# Email Brevo (fonctions Vercel, jamais exposé au navigateur)
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="noreply@borneflix.fr"
BREVO_SENDER_NAME="BorneFlix"
BREVO_RECIPIENT_EMAIL="contact@borneflix.fr"

# Environment
NODE_ENV="development"

# Vercel
VERCEL_URL="https://your-app.vercel.app"

# Optional: Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Optional: Social Media
FACEBOOK_APP_ID="your_facebook_app_id"
LINKEDIN_CLIENT_ID="your_linkedin_client_id" 